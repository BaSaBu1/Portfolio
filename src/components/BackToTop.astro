---
// Floating "back to top": a Mongolian recurve bow with an arrow pointing up.
// On click the string snaps, the arrow flies up out of the button, and the page
// glides to the top. Appears once you're past the hero.
const rest = "M4.6 13.6 L12 13.6 L19.4 13.6";
const drawn = "M4.6 13.6 L12 17.2 L19.4 13.6";
const snap = "M4.6 13.6 L12 12.6 L19.4 13.6";
---

<button class="to-top" type="button" aria-label="Back to top" data-to-top>
    <svg viewBox="0 0 24 24" aria-hidden="true">
        <!-- bow: grip at the top, limbs sweep down, then the stiff straight "ears"
             (siyahs) of a Mongolian composite bow angle back outward -->
        <path
            class="bow"
            d="M2.2 10.9 L4.6 13.6 C6.1 10.1 8.9 7.6 12 7.4 C15.1 7.6 17.9 10.1 19.4 13.6 L21.8 10.9"
        ></path>
        <path class="string" d={rest}>
            <animate
                attributeName="d"
                dur="0.5s"
                begin="indefinite"
                values={`${rest};${drawn};${drawn};${snap};${rest}`}
                keyTimes="0;0.35;0.45;0.62;1"
                fill="freeze"
                data-pull></animate>
        </path>
        <g class="arrow">
            <path d="M12 16.4 L12 2.8"></path>
            <path d="M9.9 4.9 L12 2.8 L14.1 4.9"></path>
            <path d="M10.6 17.8 L12 16.4 L13.4 17.8"></path>
        </g>
    </svg>
</button>

<script>
    const button = document.querySelector<HTMLButtonElement>("[data-to-top]");
    const pull = button?.querySelector<SVGAnimateElement>("[data-pull]");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const hero = document.querySelector<HTMLElement>("#top");

    if (button) {
        let ticking = false;
        const update = () => {
            ticking = false;
            const threshold = hero ? hero.offsetTop + hero.offsetHeight * 0.8 : 600;
            const menuOpen = document.body.classList.contains("is-locked");
            button.classList.toggle("is-visible", window.scrollY > threshold && !menuOpen);
        };
        window.addEventListener(
            "scroll",
            () => {
                if (!ticking) {
                    ticking = true;
                    requestAnimationFrame(update);
                }
            },
            { passive: true },
        );
        update();

        let busy = false;
        button.addEventListener("click", () => {
            if (reduced.matches) {
                window.scrollTo({ top: 0, behavior: "auto" });
                return;
            }
            if (busy) return;
            busy = true;
            pull?.beginElement();
            button.classList.add("is-shooting");
            // release at the moment the string snaps forward
            window.setTimeout(() => window.scrollTo({ top: 0, behavior: "smooth" }), 260);
            window.setTimeout(() => {
                button.classList.remove("is-shooting");
                busy = false;
            }, 1100);
        });
    }
</script>

<style>
    .to-top {
        position: fixed;
        right: max(16px, env(safe-area-inset-right));
        bottom: max(16px, env(safe-area-inset-bottom));
        z-index: 45;
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        padding: 0;
        border: 1px solid var(--rule);
        border-radius: 50%;
        background: var(--paper);
        color: var(--ink);
        box-shadow: 0 10px 24px -14px rgb(0 0 0 / 0.4);
        cursor: pointer;
        opacity: 0;
        transform: translateY(12px);
        pointer-events: none;
        transition:
            opacity 0.3s var(--ease),
            transform 0.3s var(--ease),
            color 0.2s,
            border-color 0.2s;
    }
    .to-top.is-visible {
        opacity: 1;
        transform: none;
        pointer-events: auto;
    }
    .to-top:hover {
        color: var(--accent);
        border-color: var(--accent);
    }
    svg {
        width: 28px;
        height: 28px;
        overflow: visible;
    }
    svg path {
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .bow {
        stroke-width: 1.6;
    }
    .string {
        stroke-width: 0.9;
    }
    .arrow path {
        stroke-width: 1.3;
    }
    .arrow {
        transform-box: view-box;
    }
    .is-shooting .arrow {
        animation: shoot 1.05s both;
    }
    /* drawn back with the string, released, flies off; a new arrow slides in */
    @keyframes shoot {
        0% {
            transform: translateY(0);
            opacity: 1;
            animation-timing-function: ease-out;
        }
        24% {
            transform: translateY(3.6px);
            opacity: 1;
            animation-timing-function: cubic-bezier(0.5, 0, 1, 0.6);
        }
        46% {
            transform: translateY(-34px);
            opacity: 0;
        }
        62% {
            transform: translateY(10px);
            opacity: 0;
            animation-timing-function: ease-out;
        }
        100% {
            transform: translateY(0);
            opacity: 1;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .to-top {
            transition: opacity 0.2s;
            transform: none;
        }
    }
</style>

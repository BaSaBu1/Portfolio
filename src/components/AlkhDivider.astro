---
import Footnote from "./Footnote.astro";

interface Props {
    // show the footnote marker (only on the first divider of a page)
    note?: boolean;
}

const { note = false } = Astro.props;
const id = `alkh-${Math.random().toString(36).slice(2, 8)}`;

// The band is split into two interlocking combs of hammers: upright T's rising from the
// bottom and inverted T's hanging from the top. The line is the single boundary between
// them. One period is 20 units wide (head 15, stem 5). The tile is shifted so no
// vertical stroke touches a tile edge, keeping the repeat seamless; neighbouring
// periods are drawn too and clipped by the tile.
const P = 20;
const period: [number, number][] = [
    [-2.5, 2.5], [12.5, 2.5], [12.5, 10], [7.5, 10], [7.5, 17.5],
    [22.5, 17.5], [22.5, 10], [17.5, 10], [17.5, 2.5],
];
const d = [-P, 0, P]
    .map((dx) => "M" + period.map(([x, y]) => `${x + dx},${y}`).join(" L"))
    .join(" ");
---

<div class="alkh container" data-observe>
    <svg class="alkh-line" height="20" aria-hidden="true">
        <defs>
            <pattern id={id} width={P} height="20" patternUnits="userSpaceOnUse">
                <path d={d} fill="none" stroke="currentColor" stroke-width="1.25" />
            </pattern>
        </defs>
        <rect width="100%" height="20" fill={`url(#${id})`}></rect>
    </svg>
    {note && <Footnote id="alkh" />}
</div>

<style>
    .alkh {
        display: flex;
        align-items: center;
        gap: 14px;
        color: var(--ink-2);
    }
    .alkh-line {
        flex: 1;
        width: 100%;
        min-width: 0;
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
        transition: clip-path 2.2s cubic-bezier(0.65, 0, 0.35, 1);
    }
    :global(.js) .alkh:not(.is-in) .alkh-line {
        clip-path: inset(0 100% 0 0);
    }
    @media (prefers-reduced-motion: reduce) {
        .alkh-line {
            transition: none;
        }
        :global(.js) .alkh:not(.is-in) .alkh-line {
            clip-path: none;
        }
    }
</style>

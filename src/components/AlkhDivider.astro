---
import Footnote from "./Footnote.astro";
import { ALKH_PERIOD as P, alkhTilePath as d } from "../lib/alkh";

interface Props {
    // show the footnote marker (only on the first divider of a page)
    note?: boolean;
}

const { note = false } = Astro.props;
const id = `alkh-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="alkh container" data-observe data-note-anchor={note ? "" : undefined}>
    <svg class="alkh-line" height="20" aria-hidden="true">
        <defs>
            <pattern id={id} width={P} height="20" patternUnits="userSpaceOnUse">
                <path d={d} fill="none" stroke="currentColor" stroke-width="1.25" />
            </pattern>
        </defs>
        <rect width="100%" height="20" fill={`url(#${id})`}></rect>
    </svg>
    {note && <Footnote id="alkh" />}
</div>

<style>
    .alkh {
        display: flex;
        align-items: center;
        gap: 14px;
        color: var(--ink-2);
    }
    .alkh-line {
        flex: 1;
        width: 100%;
        min-width: 0;
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
        transition: clip-path 2.2s cubic-bezier(0.65, 0, 0.35, 1);
    }
    :global(.js) .alkh:not(.is-in) .alkh-line {
        clip-path: inset(0 100% 0 0);
    }
    @media (prefers-reduced-motion: reduce) {
        .alkh-line {
            transition: none;
        }
        :global(.js) .alkh:not(.is-in) .alkh-line {
            clip-path: none;
        }
    }
</style>

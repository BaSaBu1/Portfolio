---
import { Image } from "astro:assets";
import { links, mosaicGalleries, photography } from "../data/site";
---

<div class="mosaic">
    <ul class="covers" aria-label="Photo galleries on Mosaic">
        {
            mosaicGalleries.map((g) => (
                <li>
                    <a href={`${links.mosaic}/${g.slug}`} target="_blank" rel="noopener">
                        <Image
                            src={g.image}
                            alt=""
                            width={720}
                            height={900}
                            widths={[320, 480, 720]}
                            sizes="(min-width: 1024px) 180px, (min-width: 600px) 31vw, 62vw"
                            fit="cover"
                            loading="lazy"
                        />
                        <span class="cap">
                            <b>{g.title}</b>
                            <small>{g.subtitle}</small>
                        </span>
                    </a>
                </li>
            ))
        }
    </ul>

    <div class="project" data-reveal>
        <p class="text">{photography.text}</p>
        <p class="more-link">
            <a href={links.mosaic} target="_blank" rel="noopener">
                See all {photography.stats} on Mosaic <span class="arrow" aria-hidden="true">→</span>
            </a>
        </p>
    </div>
</div>

<style>
    .covers {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 62%;
        gap: 12px;
        margin-inline: calc(var(--gutter) * -1);
        padding-inline: var(--gutter);
        padding-bottom: 6px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-padding-inline: var(--gutter);
        scrollbar-width: none;
    }
    .covers::-webkit-scrollbar {
        display: none;
    }
    .covers li {
        scroll-snap-align: start;
    }
    .covers a {
        position: relative;
        display: block;
        overflow: hidden;
        aspect-ratio: 4 / 5;
        border-radius: 4px;
        background: var(--paper-2);
        text-decoration: none;
        color: #fff;
    }
    .covers :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s var(--ease);
    }
    .covers a:hover :global(img) {
        transform: scale(1.04);
    }
    .cap {
        position: absolute;
        inset: auto 0 0 0;
        display: grid;
        padding: 40px 12px 12px;
        background: linear-gradient(transparent, rgb(0 0 0 / 0.62));
    }
    .cap b {
        font-family: var(--serif);
        font-size: 1.05rem;
        font-weight: 400;
        line-height: 1.2;
    }
    .cap small {
        font-size: 0.72rem;
        opacity: 0.85;
    }

    .project {
        display: grid;
        gap: 18px;
        justify-items: start;
        margin-top: clamp(22px, 3vw, 34px);
    }
    /* same plain underlined link as "Read the full story" */
    .more-link {
        font-weight: 600;
    }
    /* a personal line: styled exactly like the Journey intro */
    .text {
        max-width: 44ch;
        font-family: var(--serif);
        font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.6rem);
        line-height: 1.4;
    }

    @media (min-width: 600px) {
        .covers {
            grid-auto-flow: row;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            margin-inline: 0;
            padding-inline: 0;
            overflow: visible;
        }
    }
    @media (min-width: 1024px) {
        .covers {
            grid-template-columns: repeat(6, minmax(0, 1fr));
        }
    }
</style>

---
import { Image } from "astro:assets";
import { links, mosaicGalleries, photography } from "../data/site";
---

<div class="mosaic">
    <ul class="covers" data-covers aria-label="Photo galleries on Mosaic">
        {
            mosaicGalleries.map((g) => (
                <li>
                    <a href={`${links.mosaic}/${g.slug}`} target="_blank" rel="noopener">
                        <Image
                            src={g.image}
                            alt=""
                            width={720}
                            height={900}
                            widths={[320, 480, 720]}
                            sizes="(min-width: 1024px) 180px, (min-width: 600px) 31vw, 62vw"
                            fit="cover"
                            loading="lazy"
                        />
                        <span class="cap">
                            <b>{g.title}</b>
                            <small>{g.subtitle}</small>
                            <span class="open">
                                {g.photos} photos <span class="arrow" aria-hidden="true">→</span>
                            </span>
                        </span>
                    </a>
                </li>
            ))
        }
    </ul>
    <!-- phones only: shows the strip scrolls sideways and where you are in it -->
    <div class="swipe" aria-hidden="true">
        <span class="track"><i data-thumb></i></span>
        <span class="count" data-count>1 / {mosaicGalleries.length}</span>
        <span class="hint">Swipe →</span>
    </div>

    <div class="project" data-reveal>
        <p class="text">{photography.text}</p>
        <p class="more-link">
            <a href={links.mosaic} target="_blank" rel="noopener">
                See all {photography.stats} on Mosaic <span class="arrow" aria-hidden="true">→</span>
            </a>
        </p>
    </div>
</div>

<script>
    const strip = document.querySelector<HTMLElement>("[data-covers]");
    const thumb = document.querySelector<HTMLElement>("[data-thumb]");
    const count = document.querySelector<HTMLElement>("[data-count]");
    const phone = matchMedia("(max-width: 599px)");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");

    if (strip && thumb) {
        const items = strip.children.length;
        let swiped = false;

        const update = () => {
            const max = strip.scrollWidth - strip.clientWidth;
            const visible = strip.clientWidth / strip.scrollWidth;
            const progress = max > 0 ? strip.scrollLeft / max : 0;
            thumb.style.width = `${visible * 100}%`;
            thumb.style.transform = `translateX(${(progress * (1 - visible) * 100) / visible}%)`;
            if (count) count.textContent = `${Math.min(items, Math.round(progress * (items - 1)) + 1)} / ${items}`;
        };
        strip.addEventListener(
            "scroll",
            () => {
                swiped = true;
                requestAnimationFrame(update);
            },
            { passive: true },
        );
        window.addEventListener("resize", update);
        update();

        // one gentle nudge the first time the strip comes into view, so it's clear it moves
        const io = new IntersectionObserver(
            ([entry]) => {
                if (!entry.isIntersecting) return;
                io.disconnect();
                if (!phone.matches || reduced.matches) return;
                window.setTimeout(() => {
                    if (swiped) return;
                    strip.scrollBy({ left: 70, behavior: "smooth" });
                    window.setTimeout(() => strip.scrollTo({ left: 0, behavior: "smooth" }), 650);
                }, 400);
            },
            { threshold: 0.6 },
        );
        io.observe(strip);
    }
</script>

<style>
    .covers {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 64%;
        gap: 12px;
        margin-inline: calc(var(--gutter) * -1);
        padding-inline: var(--gutter);
        padding-bottom: 6px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-padding-inline: var(--gutter);
        scrollbar-width: none;
    }
    .covers::-webkit-scrollbar {
        display: none;
    }
    /* each cover is an album: two card edges peek out above it like a stack of prints */
    .covers li {
        position: relative;
        padding-top: 12px;
        scroll-snap-align: start;
    }
    .covers li::before,
    .covers li::after {
        content: "";
        position: absolute;
        height: 40px;
        border-radius: 4px;
        transition: transform 0.35s var(--ease);
    }
    .covers li::before {
        inset: 0 16px auto;
        background: color-mix(in srgb, var(--ink) 18%, var(--paper));
    }
    .covers li::after {
        inset: 6px 8px auto;
        background: color-mix(in srgb, var(--ink) 34%, var(--paper));
    }
    .covers li:hover::before {
        transform: translateY(-3px) rotate(-1.2deg);
    }
    .covers li:hover::after {
        transform: translateY(-2px) rotate(0.8deg);
    }
    .covers a {
        position: relative;
        z-index: 1;
        display: block;
        overflow: hidden;
        aspect-ratio: 4 / 5;
        border-radius: 4px;
        background: var(--paper-2);
        text-decoration: none;
        color: #fff;
    }
    .covers :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s var(--ease);
    }
    .covers a:hover :global(img) {
        transform: scale(1.04);
    }
    .cap {
        position: absolute;
        inset: auto 0 0 0;
        display: grid;
        padding: 40px 12px 12px;
        background: linear-gradient(transparent, rgb(0 0 0 / 0.62));
    }
    .cap b {
        font-family: var(--serif);
        font-size: 1.05rem;
        font-weight: 400;
        line-height: 1.2;
    }
    .open {
        margin-top: 6px;
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.02em;
    }
    .covers a:hover .open .arrow {
        transform: translateX(3px);
    }
    .cap small {
        font-size: 0.72rem;
        opacity: 0.85;
    }

    .project {
        display: grid;
        gap: 18px;
        justify-items: start;
        margin-top: clamp(22px, 3vw, 34px);
    }
    /* same plain underlined link as "Read the full story" */
    .more-link {
        font-weight: 600;
    }
    /* a personal line: styled exactly like the Journey intro */
    .text {
        max-width: 44ch;
        font-family: var(--serif);
        font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.6rem);
        line-height: 1.4;
    }

    .swipe {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 12px;
        font-family: var(--mono);
        font-size: 0.72rem;
        color: var(--ink-3);
    }
    .track {
        position: relative;
        flex: 1;
        height: 2px;
        overflow: hidden;
        background: var(--rule);
    }
    .track i {
        position: absolute;
        inset: 0 auto 0 0;
        width: 40%;
        background: var(--ink-2);
        transition: transform 0.1s linear;
    }
    .hint {
        color: var(--ink-2);
    }

    @media (min-width: 600px) {
        .swipe {
            display: none;
        }
        .covers {
            grid-auto-flow: row;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            margin-inline: 0;
            padding-inline: 0;
            overflow: visible;
        }
    }
    @media (min-width: 1024px) {
        .covers {
            grid-template-columns: repeat(6, minmax(0, 1fr));
        }
    }
</style>
